          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire usa la tua rete locale per le chiamate tra dispositivi sulla stessa rete e per connettersi a un'istanza echowire in esecuzione sulla tua rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire、同じネットワーク上のデバイス間での通話と、ネットワーク上で動作しているechowire。"
