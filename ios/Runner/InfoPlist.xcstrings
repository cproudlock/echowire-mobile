    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم echowire الكاميرا عندما تلتقط صورة لإرسالها في دردشة أو عندما تشغّل الكاميرا في مكالمة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire използва камерата, когато правиш снимка, за да я изпратиш в чат, или когато включиш камерата си в разговор."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire používá fotoaparát, když pořizujete fotku k odeslání do chatu nebo když v hovoru zapnete kameru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire bruger kameraet, når du tager et billede for at sende det i en chat eller slår dit kamera til i et opkald."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire verwendet die Kamera, wenn du ein Foto aufnimmst, um es in einem Chat zu senden, oder wenn du in einem Anruf deine Kamera einschaltest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το echowire χρησιμοποιεί την κάμερα όταν τραβάτε μια φωτογραφία για να τη στείλετε σε συνομιλία ή ενεργοποιείτε την κάμερά σας σε μια κλήση."
          }
        },
        "en" : {
          "stringUnit" : {
