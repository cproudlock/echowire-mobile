          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το echowire χρησιμοποιεί το μικρόφωνο όταν ηχογραφείτε φωνητικό μήνυμα, μιλάτε σε φωνητική κλήση ή βιντεοκλήση ή δοκιμάζετε το μικρόφωνό σας στις ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire uses the microphone when you record a voice message, talk in a voice or video call, or test your microphone in settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire uses the microphone when you record a voice message, talk in a voice or video call, or test your microphone in settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire usa el micrófono cuando grabas un mensaje de voz, hablas en una llamada de voz o vídeo, o pruebas el micrófono en los ajustes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire usa el micrófono cuando grabas un mensaje de voz, hablas en una llamada de voz o video, o pruebas tu micrófono en la configuración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
