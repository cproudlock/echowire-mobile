    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم echowire شبكتك المحلية للمكالمات بين الأجهزة على الشبكة نفسها وللاتصال بمثيل echowire يعمل على شبكتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire използва локалната ти мрежа за разговори между устройства в една и съща мрежа и за свързване с инстанция на echowire, работеща в мрежата ти."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire používá vaši místní síť pro hovory mezi zařízeními ve stejné síti a pro připojení k instanci echowire běžící ve vaší síti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire bruger dit lokale netværk til opkald mellem enheder på samme netværk og til at oprette forbindelse til en echowire, der kører på dit netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire verwendet dein lokales Netzwerk für Anrufe zwischen Geräten im selben Netzwerk und um sich mit einer echowire in deinem Netzwerk zu verbinden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το echowire χρησιμοποιεί το τοπικό σας δίκτυο για κλήσεις μεταξύ συσκευών στο ίδιο δίκτυο και για σύνδεση σε μια παρουσία echowire που εκτελείται στο δίκτυό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire uses your local network for calls between devices on the same network and to connect to a echowire instance running on your network."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire uses your local network for calls between devices on the same network and to connect to a echowire instance running on your network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire usa tu red local para las llamadas entre dispositivos de la misma red y para conectarse a una instancia de echowire que funcione en tu red."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire usa tu red local para llamadas entre dispositivos de la misma red y para conectarse a una instancia de echowire que se ejecuta en tu red."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire käyttää lähiverkkoasi saman verkon laitteiden välisiin puheluihin ja yhteyden muodostamiseen verkossasi toimivaan echowire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire utilise votre réseau local pour les appels entre appareils connectés au même réseau et pour se connecter à une instance echowire qui tourne sur votre réseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire משתמש ברשת המקומית שלך לשיחות בין מכשירים באותה רשת ולהתחברות למופע echowire שפועל ברשת שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire आपके लोकल नेटवर्क का इस्तेमाल एक ही नेटवर्क पर मौजूद डिवाइस के बीच कॉल के लिए और आपके नेटवर्क पर चल रहे echowire इंस्टेंस से कनेक्ट करने के लिए करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire koristi vašu lokalnu mrežu za pozive između uređaja na istoj mreži i za povezivanje s echowire instancom koja radi na vašoj mreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A echowire a helyi hálózatodat az ugyanazon a hálózaton lévő eszközök közötti hívásokhoz, valamint a hálózatodon futó echowire való csatlakozáshoz használja."
