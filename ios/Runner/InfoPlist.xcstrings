    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم echowire الميكروفون عندما تسجّل رسالة صوتية، أو تتحدث في مكالمة صوتية أو مكالمة فيديو، أو تختبر الميكروفون في الإعدادات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire използва микрофона, когато записваш гласово съобщение, говориш в гласов или видеоразговор или тестваш микрофона си в настройките."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire používá mikrofon, když nahráváte hlasovou zprávu, mluvíte v hlasovém nebo video hovoru nebo testujete mikrofon v nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire bruger mikrofonen, når du optager en talebesked, taler i et tale- eller videoopkald eller tester din mikrofon i indstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
