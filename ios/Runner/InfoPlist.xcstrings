            "state" : "translated",
            "value" : "echowire bruker det lokale nettverket ditt til samtaler mellom enheter på samme nettverk og til å koble til en echowire som kjører på nettverket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire gebruikt je lokale netwerk voor gesprekken tussen apparaten op hetzelfde netwerk en om verbinding te maken met een echowire die op je netwerk draait."
          }
        },
        "pl" : {
