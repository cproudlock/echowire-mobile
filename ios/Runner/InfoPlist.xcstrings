        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echowire naudoja jūsų vietinį tinklą skambučiams tarp to paties tinklo įrenginių ir prisijungimui prie jūsų tinkle veikiančios echowire instancijos."
